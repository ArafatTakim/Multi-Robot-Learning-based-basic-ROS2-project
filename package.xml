  <version>0.1.0</version>
  <description>Basic multi-robot reinforcement learning with knowledge sharing in ROS 2</description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
